# included by GNUMakefile and inifile/makefile

OBJ_DIR = obj/$(SYS)
OBJ     = $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC))
DEPS    = $(patsubst %.c, $(OBJ_DIR)/%.d, $(SRC))

$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(ECHO) Compiling $(notdir $<) ...
	$(DEBUG)$(CC) $(CFLAGS) -o $@ -c $<

.PHONY : all
all: $(SUBDIRS) $(EXE)$ $(LIB)

.PHONY : $(SUBDIRS)
$(SUBDIRS):
	$(MAKE) -C $@ $(TARGET)

# used by initfile/makefile
$(LIB): $(OBJ)
	$(ECHO) Archiving $@ ...
	$(DEBUG)$(AR) $@ $(OBJ)
	$(ECHO) Done

$(EXE): $(OBJ)
	$(ECHO) Linking $@ ...
	$(DEBUG)$(LD) $(OBJ) $(LDFLAGS) $(addprefix -l,$(LIBS)) -o $@
	$(ECHO) Done

.PHONY : clean
clean:	TARGET := clean
clean:	$(SUBDIRS)
	$(ECHO) Deleting $(OBJ) $(DEPS) $(LIB) $(EXE) ...
	$(DEBUG)-$(RM) $(OBJ) $(DEPS) $(LIB) $(EXE)

.PHONY: force
.compiler_flags: force
	@echo '$(CDEFS)' | cmp -s - $@ || echo '$(CDEFS)' > $@

$(OBJ): .compiler_flags

-include $(DEPS)
